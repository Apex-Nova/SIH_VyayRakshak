# ─── Nirikshak AI — Environment Configuration ───────────────────────────────
# All values below are OPTIONAL. The application runs fully in DEMO MODE with
# generated, illustrative data when nothing is configured.

# Data provider: "mock" (default, generated demo data) | "official" (not yet wired)
NEXT_PUBLIC_DATA_PROVIDER=mock

# Demo mode banner. When true the UI clearly labels data as illustrative.
NEXT_PUBLIC_DEMO_MODE=true

# ─── AI / LLM provider (optional) ───────────────────────────────────────────
# The AI layer uses a provider abstraction (src/lib/ai/provider.ts). When no
# key is set, a deterministic mock intelligence layer answers queries.
# AI_PROVIDER=anthropic | openai | mock
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Gemini fallback for the "Ask VyayRakshak" chatbot. OPTIONAL.
# When set, the assistant escalates to Gemini ONLY for questions the built-in
# deterministic layer can't answer confidently. Without a key it stays fully
# offline (deterministic answers over the app's own data).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ─── Database (optional — for the "scale to real MPLADS data" story) ─────────
# A Prisma schema is provided in prisma/schema.prisma. The demo does NOT
# require a database; it runs on the in-memory generated dataset.
# DATABASE_URL="postgresql://user:password@localhost:5432/nirikshak?schema=public"

# ─── Auth (optional) ────────────────────────────────────────────────────────
# Demo login is available without configuration.
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
